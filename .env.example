# MapKit JS — the Places widget's "Explore the map" control.
#
# A static, domain-bound MapKit JS token from the Apple Developer portal
# (Certificates, Identifiers & Profiles → Maps Tokens). It is not a secret:
# Next inlines NEXT_PUBLIC_* into the client bundle at build time and MapKit
# sends it to Apple from the browser either way. Bind it to your deployed
# domain in the portal — that binding, not secrecy, is what protects the quota.
#
# Leave it unset and the widget renders exactly as it did before the feature
# existed: inline SVG, no button, no JavaScript.
NEXT_PUBLIC_MAPKIT_TOKEN=

# Contact studio — the letterbox at app/api/contact delivers a posted letter
# to the address in lib/content.ts as an email, through Resend.
#
# RESEND_API_KEY is a real secret (server-only, never NEXT_PUBLIC_): create it
# at resend.com → API Keys, and set it in Vercel's project environment too.
# Without a domain of your own on file, Resend's shared sender delivers only
# to the address that owns the key — which is the address in lib/content.ts,
# so that is enough. Leave it unset and a send comes back to the visitor with
# a mailto link as the plain way out.
RESEND_API_KEY=

# Optional. The sender line on the delivered email. Defaults to Resend's
# shared onboarding@resend.dev; once a domain is verified at Resend, set
# something like "Portfolio <letters@yourdomain.com>".
CONTACT_FROM=

# Optional. Post the letter somewhere else instead of /api/contact — any
# service that accepts a JSON POST of { name, email, message } and answers 2xx
# (Formspree, Basin, a Worker of your own). Not a secret: Next inlines
# NEXT_PUBLIC_* into the client bundle. Set it to the empty string to turn the
# wire off entirely and hand the letter to the visitor's mail client instead.
# NEXT_PUBLIC_CONTACT_ENDPOINT=

# Listening card (/life) — the song in lib/content.ts is looked up in the
# Apple Music catalog at build time by lib/listening.ts: cover, album, year,
# the Apple Music link and the 30s preview. Catalog reads need only a
# developer token, which the build signs itself from a MusicKit private key
# (Apple Developer → Certificates, Identifiers & Profiles → Keys → MusicKit).
#
# All three are server-only and never reach the browser. TEAM_ID is the
# 10-character team identifier from the portal's Membership page; KEY_ID is
# the one in the downloaded file's name, AuthKey_<KEY_ID>.p8.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# The .p8 file's contents. Locally you can leave this unset and keep the file
# in the project root as AuthKey_<KEY_ID>.p8 — .gitignore keeps *.p8 out of
# the repo. On Vercel paste the whole file, line breaks and all.
# Unset, the card still works: the cover, the Apple Music link and the 30s
# preview come from the keyless iTunes Search endpoint instead, and the only
# thing lost is Apple's own colour reading of the cover, so the record is
# pressed in the blank black from lib/content.ts. Set it to get the colours.
#
# Note that .gitignore keeps both the .p8 and .env.local out of the repo, so a
# deployment only ever has these if they were added to its environment by hand
# (Vercel → Project → Settings → Environment Variables), and the private key
# goes in as the whole file, line breaks and all.
APPLE_MUSIC_PRIVATE_KEY=

# Weather (footer stamp, and the location card on home) — Apple WeatherKit.
#
# The reading is Hamburg's current conditions, read through WeatherKit's REST
# API by lib/weather.ts and served to the page by app/api/weather. All of it
# is server-only; nothing about the key reaches the browser.
#
# A WeatherKit token names a *service* as well as a key, so this needs one
# more identifier than the Apple Music card does:
#
#   WEATHERKIT_SERVICE_ID  an identifier from Apple Developer → Certificates,
#                          Identifiers & Profiles → Identifiers with the
#                          WeatherKit capability enabled (an App ID or a
#                          Services ID, e.g. com.yourdomain.weather).
#   WEATHERKIT_KEY_ID      the one in the downloaded file's name,
#                          AuthKey_<KEY_ID>.p8 — a key with WeatherKit enabled
#                          under Keys, which is a different key from MusicKit's.
#   WEATHERKIT_TEAM_ID     optional. The 10-character team identifier from the
#                          portal's Membership page. Left unset it falls back
#                          to APPLE_MUSIC_TEAM_ID, which is the same team.
#
# Leave any of them unset and the footer keeps the static line in
# lib/content.ts and the location card shows no weather at all — the route
# answers 503 and the page is exactly what it was before the feature existed.
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_TEAM_ID=
# The .p8 file's contents. Locally leave this unset and keep the file in the
# project root as AuthKey_<KEY_ID>.p8 — .gitignore keeps *.p8 out of the repo.
# On Vercel paste the whole file, line breaks and all.
WEATHERKIT_PRIVATE_KEY=

# Instagram (the six squares on the home card) — the account's own posts, read
# through the Instagram API with Instagram Login (graph.instagram.com).
#
# Note what this is *not*: the oEmbed endpoint. oEmbed takes one post URL and
# returns one Instagram-rendered blockquote; it has no listing, and a profile
# URL is refused outright. Listing an account's posts is only possible as the
# account, which is what this token is for.
#
# Two conditions before any of this works:
#
#   1. @mehunabhi must be a *professional* account (Settings → Account type →
#      switch to Creator or Business). A personal account cannot be read by
#      this API at all.
#   2. A Meta app with the "Instagram" product added, at developers.facebook.com
#      → Apps → your app → Instagram → API setup with Instagram login.
#
# Then the token, which is a real secret (server-only, never NEXT_PUBLIC_).
# The quickest path is the dashboard's own button: Instagram → API setup with
# Instagram login → "Generate token", which hands back a 60-day token. By hand
# it is the three-step exchange instead:
#
#   https://www.instagram.com/oauth/authorize?client_id=<APP_ID>
#     &redirect_uri=<REDIRECT>&response_type=code&scope=instagram_business_basic
#   POST https://api.instagram.com/oauth/access_token   (code → short-lived)
#   GET  https://graph.instagram.com/access_token?grant_type=ig_exchange_token
#     &client_secret=<SECRET>&access_token=<SHORT>      (short → 60-day)
#
# The 60 days are the standing cost of this feature. A token can be refreshed
# once it is a day old and before it expires, which resets the clock:
#
#   curl "https://graph.instagram.com/refresh_access_token\
# ?grant_type=ig_refresh_token&access_token=$INSTAGRAM_ACCESS_TOKEN"
#
# Miss the window and the only way back is logging in again for a new one, so
# refresh around day 50 and paste the answer here and into Vercel.
#
# Leave it unset and the card is exactly what it was before this existed: the
# six local originals from lib/content's `photography.squares`, each opening
# the gallery. Nothing about the token reaches the browser either way — the
# squares are served through app/api/instagram/image, because Instagram's own
# image URLs are signed and expire.
INSTAGRAM_ACCESS_TOKEN=

# Optional. The Graph version lib/instagram.ts calls. Defaults to v25.0; set
# it when that one is retired rather than editing the code.
# INSTAGRAM_GRAPH_VERSION=
