# MapKit JS — the Places widget's "Explore the map" control.
#
# A static, domain-bound MapKit JS token from the Apple Developer portal
# (Certificates, Identifiers & Profiles → Maps Tokens). It is not a secret:
# Next inlines NEXT_PUBLIC_* into the client bundle at build time and MapKit
# sends it to Apple from the browser either way. Bind it to your deployed
# domain in the portal — that binding, not secrecy, is what protects the quota.
#
# Leave it unset and the widget renders exactly as it did before the feature
# existed: inline SVG, no button, no JavaScript.
NEXT_PUBLIC_MAPKIT_TOKEN=

# Contact studio — the letterbox at app/api/contact delivers a posted letter
# to the address in lib/content.ts as an email, through Resend.
#
# RESEND_API_KEY is a real secret (server-only, never NEXT_PUBLIC_): create it
# at resend.com → API Keys, and set it in Vercel's project environment too.
# Without a domain of your own on file, Resend's shared sender delivers only
# to the address that owns the key — which is the address in lib/content.ts,
# so that is enough. Leave it unset and a send comes back to the visitor with
# a mailto link as the plain way out.
RESEND_API_KEY=

# Optional. The sender line on the delivered email. Defaults to Resend's
# shared onboarding@resend.dev; once a domain is verified at Resend, set
# something like "Portfolio <letters@yourdomain.com>".
CONTACT_FROM=

# Optional. Post the letter somewhere else instead of /api/contact — any
# service that accepts a JSON POST of { name, email, message } and answers 2xx
# (Formspree, Basin, a Worker of your own). Not a secret: Next inlines
# NEXT_PUBLIC_* into the client bundle. Set it to the empty string to turn the
# wire off entirely and hand the letter to the visitor's mail client instead.
# NEXT_PUBLIC_CONTACT_ENDPOINT=

# Listening card (/life) — the song in lib/content.ts is looked up in the
# Apple Music catalog at build time by lib/listening.ts: cover, album, year,
# the Apple Music link and the 30s preview. Catalog reads need only a
# developer token, which the build signs itself from a MusicKit private key
# (Apple Developer → Certificates, Identifiers & Profiles → Keys → MusicKit).
#
# All three are server-only and never reach the browser. TEAM_ID is the
# 10-character team identifier from the portal's Membership page; KEY_ID is
# the one in the downloaded file's name, AuthKey_<KEY_ID>.p8.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# The .p8 file's contents. Locally you can leave this unset and keep the file
# in the project root as AuthKey_<KEY_ID>.p8 — .gitignore keeps *.p8 out of
# the repo. On Vercel paste the whole file, line breaks and all.
# Unset, or if Apple cannot be reached at build, the card still shows the
# title and artist from lib/content.ts — just without the cover and links.
APPLE_MUSIC_PRIVATE_KEY=
